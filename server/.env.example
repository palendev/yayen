# Copia este archivo a server/.env y rellénalo. server/.env está en .gitignore: nunca lo subas.

# Dónde escucha el servidor de ejemplo
YAYEN_HOST=127.0.0.1
YAYEN_PORT=8787

# ---------- Voz (Piper local; la instala tools/instalar-voz.sh) ----------
YAYEN_PIPER=/opt/yayen/piper/bin/piper
YAYEN_MODEL=/opt/yayen/piper/voces/es_ES-mls_10246-low.onnx
# digital = +2 semitonos, coro y eco leves (la voz de Yayen) · natural = sin ajuste
YAYEN_PRESET=digital

# ---------- Hermes (lo que le dices a Yayen manteniéndolo pulsado) ----------
# URL base de la API de Hermes en tu red, sin barra final. Ejemplo: http://192.168.1.50:8642
HERMES_URL=
# Ruta para mandarle mensajes. Si su API es compatible con OpenAI: /v1/chat/completions
HERMES_CHAT_PATH=/v1/chat/completions
# Clave o token de la API de Hermes. Se envía como «Authorization: Bearer …» y nunca sale de este servidor.
HERMES_TOKEN=
# Modelo o perfil, solo si la API lo pide
HERMES_MODEL=
# Segundos de espera máximos
HERMES_TIMEOUT=60
# Personalidad de las respuestas (opcional)
# YAYEN_SYSTEM_PROMPT=Eres Yayen, la mascota del panel. Respondes en español, breve y cercano.
